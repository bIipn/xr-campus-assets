# Blender (bpy) venv lives in bl/; only the scripts are tracked. It can't go on GitHub:
# bpy/__init__.so alone is 210 MB (GitHub caps files at 100 MB) and the binaries are Linux-only.
# Reinstall with: python3.13 -m venv bl && bl/bin/pip install bpy==5.2.2
bl/*
!bl/*.py
!bl/fonts/
# Blender builds of the museum and grounds: the .blend files rebuild in seconds (bl/museum.py, bl/exterior.py); the previews stay
assets/museum/*.blend*
assets/exterior/*.blend*
# Installed tools and download caches (reinstall / redownload)
node_modules/
ktx/
mh/
__pycache__/
# Local-run copies (see README)
deploy/h/
deploy/lib/

# Blender builds of the museum and grounds (bl/museum.py, bl/exterior.py): rebuilt in seconds; only the prepared out/ue copies are kept
unreal/Pipeline/out/museum/Museum.glb
unreal/Pipeline/out/props/*.glb
unreal/Pipeline/out/exterior/Outside.glb
# derived by unreal/Tools/holds/design_holds.py
unreal/Tools/holds/holds.json
unreal/Tools/holds/hold_*.png
assets/build_*.log

# Talk and quiz voice lines (unreal/Tools/voice/make_talk_voices.py): regenerated from talks.json, copied to the Unreal machine
unreal/Pipeline/out/voice/

# slide previews are for looking at here; the PNGs are what Unreal imports
unreal/Pipeline/out/slides/*/preview_*.jpg

# Blender builds of the talks wing and the classroom (bl/auditorium.py, bl/classroom.py): only the prepared out/ue copies are kept
unreal/Pipeline/out/auditorium/Auditorium.glb
unreal/Pipeline/out/classroom/Classroom.glb
unreal/Pipeline/out/training/Training.glb
assets/auditorium/*.blend*
assets/classroom/*.blend*
assets/training/*.blend*

# Unreal build products and caches (regenerated on every machine)
WalkTheArchive/Binaries/
WalkTheArchive/Intermediate/
WalkTheArchive/Saved/
WalkTheArchive/DerivedDataCache/
WalkTheArchive/Build/
WalkTheArchive/Plugins/*/Binaries/
WalkTheArchive/Plugins/*/Intermediate/
WalkTheArchive/.vs/
WalkTheArchive/.idea/
WalkTheArchive/*.sln
WalkTheArchive/*.slnx
WalkTheArchive/.vsconfig
WalkTheArchive/*.xcworkspace
WalkTheArchive/*.code-workspace
WalkTheArchive/Packaged/
# Python bytecode
__pycache__/
*.pyc
# Local tool caches
Tools/.cache/
# Intermediate exports (regenerate with unreal/Pipeline/web/export_campus.py and
# unreal/Pipeline/blender/export_reading_room.py); Unreal imports unreal/Pipeline/out/ue/*.glb
Pipeline/out/campus/*.glb
Pipeline/out/reading_room/*.glb
# Unreal content is generated on each machine by Scripts/setup_project.py and can grow to tens of GB
# (imported meshes, textures, MetaHumans). Keep it out of GitHub; back it up separately (see COWORK.md).
# Content/Python holds the setup scripts and stays tracked.
WalkTheArchive/Content/*
!WalkTheArchive/Content/Python/

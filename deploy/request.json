{"name":"xr-campus-concept","target":"production","projectSettings":{"framework":null},"files":[{"file":"c/6e1c2825ed5b.bin","sha":"6e1c2825ed5b3bc0dc33ae68259a805980438815","size":12000},{"file":"c/4086c1428e49.bin","sha":"4086c1428e4940b7542447e5c5ce279936bd7160","size":12000},{"file":"c/2b792c4325e5.bin","sha":"2b792c4325e5af92a360c310f3e01e5514f3a6a9","size":12000},{"file":"c/feee95bfaa11.bin","sha":"feee95bfaa11c5744b56d335b0752aa04bf3bf09","size":12000},{"file":"c/fac9cb91d5a6.bin","sha":"fac9cb91d5a6ef4644fe86a73f25525d2530acad","size":12000},{"file":"c/abf859d85f2a.bin","sha":"abf859d85f2a3d725925b65bcd9dbd5c6278073e","size":12000},{"file":"c/b73ae7475c1e.bin","sha":"b73ae7475c1edfd33052f2f07bd81e6143fde59b","size":12000},{"file":"c/5085b758f748.bin","sha":"5085b758f748d010933261163ac3f4d46bd96c80","size":12000},{"file":"c/b49757c83525.bin","sha":"b49757c83525aa457724834e7a222db57ef4b0cb","size":1600},{"file":"index.html","data":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta name=\"theme-color\" content=\"#0d1613\">\n<meta name=\"description\" content=\"An unofficial concept by Ev Holt (Walk the Archive): a walkable 3D campus about XR in libraries, with a museum, a library, a workshop school and a recess yard. Not an official XRLibraries site.\">\n<meta property=\"og:title\" content=\"XRLibraries Campus \u00b7 an unofficial concept by Ev Holt\">\n<meta property=\"og:description\" content=\"Walk a 3D museum, library, workshop school and recess yard right in your browser. Not an official XRLibraries site.\">\n<title>XRLibraries Campus \u00b7 Unofficial concept by Ev Holt</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&family=Libre+Franklin:wght@400;500;600;700&family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&display=swap\">\n<style id=\"bootcss\">\nhtml,body{margin:0;height:100%;background:#0d1613}\n#boot{position:fixed;inset:0;display:grid;place-items:center;padding:24px;color:#efe7d5;font:15px/1.5 \"Libre Franklin\",\"Helvetica Neue\",Arial,sans-serif;text-align:center}\n#boot small{display:block;color:#cda961;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase}\n#boot h1{margin:10px 0 6px;font:700 32px/1.15 \"Old Standard TT\",Georgia,serif}\n#boot p{margin:0;color:#a9b8ae}\n#boot .bar{width:180px;height:3px;margin:20px auto 0;background:#1f312b;border-radius:3px;overflow:hidden}\n#boot .bar i{display:block;width:6%;height:100%;background:#cda961;transition:width .3s ease}\n</style>\n</head>\n<body>\n<div id=\"boot\" role=\"status\" aria-live=\"polite\"><div><small>A concept by Ev Holt \u00b7 Walk the Archive</small><h1>XRLibraries Campus</h1><p id=\"bootMsg\">Loading the campus\u2026</p><div class=\"bar\" id=\"bootTrack\"><i id=\"bootBar\"></i></div></div></div>\n<script>\nwindow.__boot = (() => {\n  const C = ['/c/6e1c2825ed5b.bin','/c/4086c1428e49.bin','/c/2b792c4325e5.bin','/c/feee95bfaa11.bin','/c/fac9cb91d5a6.bin','/c/abf859d85f2a.bin','/c/b73ae7475c1e.bin','/c/5085b758f748.bin','/c/b49757c83525.bin'], bar = document.getElementById('bootBar');\n  let n = 0;\n  const p = !('DecompressionStream' in window) ? Promise.reject(new Error('old'))\n    : Promise.all(C.map((u) => fetch(u).then((r) => { if (!r.ok) throw new Error(r.status); return r.arrayBuffer(); })\n      .then((b) => { bar.style.width = (6 + 94 * ++n / C.length) + '%'; return b; })));\n  p.catch(() => {});\n  return p;\n})();\n</script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n<script>\n(async () => {\n  const stop = (t) => { document.getElementById('bootMsg').textContent = t; document.getElementById('bootTrack').hidden = true; };\n  let text;\n  try {\n    const parts = await window.__boot;\n    text = await new Response(new Blob(parts).stream().pipeThrough(new DecompressionStream('gzip'))).text();\n  } catch (e) {\n    return stop(e && e.message === 'old' ? 'This browser is too old to open the campus. Try the latest Chrome, Safari, Edge or Firefox.' : 'The campus didn\u2019t load. Check your connection, then refresh.');\n  }\n  const [css, body, js] = text.split('\\u0001');\n  const st = document.createElement('style');\n  st.textContent = css;\n  document.head.appendChild(st);\n  document.getElementById('bootcss').remove();\n  delete window.__boot;\n  document.body.innerHTML = body;\n  const s = document.createElement('script');\n  s.textContent = js;\n  document.body.appendChild(s);\n})();\n</script>\n</body>\n</html>\n","encoding":"utf-8"},{"file":"vercel.json","data":"{\n  \"headers\": [\n    { \"source\": \"/(.*)\", \"headers\": [\n      { \"key\": \"X-Robots-Tag\", \"value\": \"noindex, nofollow\" },\n      { \"key\": \"X-Content-Type-Options\", \"value\": \"nosniff\" },\n      { \"key\": \"Referrer-Policy\", \"value\": \"strict-origin-when-cross-origin\" }\n    ] },\n    { \"source\": \"/c/(.*)\", \"headers\": [\n      { \"key\": \"Cache-Control\", \"value\": \"public, max-age=31536000, immutable\" }\n    ] }\n  ]\n}\n","encoding":"utf-8"}]}